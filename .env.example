# ===== 核心金鑰 =====
OPENAI_API_KEY=your_openai_api_key

# ===== 專案資訊 =====
PROJECT_NAME=fubon-annual-report-rag
LOG_LEVEL=INFO

# ===== 檔案路徑（以專案根目錄為基準）=====
PDF_PATH=113年報.pdf
QA_EXCEL_PATH=題目一_附件_問答集.xlsx
SUPPLEMENT_PDF_PATH=題目一_補充說明.pdf
DATA_DIR=data
INDEX_DIR=outputs
OUTPUT_DIR=outputs
CHUNKS_PATH=data/processed/chunks.jsonl

# ===== 檢索參數 =====
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MIN_CONTEXT_CHUNKS=2
MIN_RETRIEVAL_SCORE=0.20

# ===== 模型參數 =====
ANSWER_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
